{
  "family": "meridian-enterprise-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::317492541707:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "meridian-enterprise-app",
      "image": "317492541707.dkr.ecr.us-east-1.amazonaws.com/meridian-enterprise-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8001,
          "hostPort": 8001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8001"
        },
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        },
        {
          "name": "MESHCENTRAL_URL",
          "value": "wss://meshcentral-nlb-57f1b2a74defca19.elb.us-east-1.amazonaws.com"
        },
        {
          "name": "MESHCENTRAL_USER",
          "value": "admin-sd"
        },
        {
          "name": "MESHCENTRAL_PASS",
          "value": "smartfix@1"
        },
        {
          "name": "MESHCTRL_PATH",
          "value": "/app/backend/bin/meshctrl.js"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/meridian-enterprise-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8001/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}
