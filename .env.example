# ==============================================================================
# Meridian Enterprise Helpdesk - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=8001
HOST=0.0.0.0

# Security
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars

# MeshCentral Remote Access Management
MESHCENTRAL_URL=wss://localhost:443
MESHCENTRAL_USER=admin-sd
MESHCENTRAL_PASS=your-meshcentral-password
MESHCTRL_PATH=backend/bin/meshctrl.js

# Atlassian Jira Cloud Integration
JIRA_INSTANCE_URL=https://<your-domain>.atlassian.net
JIRA_HOST=https://<your-domain>.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_API_KEY=your-jira-api-token
JIRA_USERNAME=your-email@company.com
JIRA_PROJECT_KEY=KAN

# Atlassian Confluence Cloud Knowledge Base
CONFLUENCE_BASE_URL=https://<your-domain>.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_API_KEY=your-confluence-api-token
CONFLUENCE_SPACE_KEY=SELFHELP

# AWS Bedrock Foundation Models (Claude 3 Haiku in ap-south-1)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
